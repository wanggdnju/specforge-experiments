# Copy to `local.env` and edit for your machine. `local.env` is git-ignored.
# Every value here overrides the corresponding default in paths.py.
# Run `python paths.py` afterwards to check what resolved.

# ---------------------------------------------------------------------------
# Two roots are in play. This toolkit drives SpecForge but does not vendor it.
# ---------------------------------------------------------------------------
# This toolkit (default: the directory holding paths.py). Normally you do not
# need to set it.
# SF_TOOLKIT=/data/workspace/specforge-experiments

# SpecForge checkout. `specforge train` runs from here, so every relative path
# in a run config resolves against it. Default: a sibling of this repo.
#   <root>/SpecForge
#   <root>/specforge-experiments
# SF_SPECFORGE=/data/workspace/SpecForge

# Workspace root containing model/, data/, venv-*/ etc.
# Default: the parent of this repo.
# SF_ROOT=/data/workspace

# ---------------------------------------------------------------------------
# Models and data
# ---------------------------------------------------------------------------
# Target model directory (also used as the tokenizer unless SF_TOKENIZER is set).
# SF_TARGET_MODEL=/data/workspace/model/Qwen3-8B
# SF_TOKENIZER=/data/workspace/model/Qwen3-8B

# Raw request dumps (data1..data8, one directory each).
# SF_RAW_DIR=/data/workspace/data/specforge/raw
# SF_DATASET_DIR=/data/workspace/data/specforge
# SF_CACHE_DIR=/data/workspace/data/specforge/cache
# SF_VOCAB_MAPPING=/data/workspace/data/specforge/vocab_mapping/qwen3-8b-data1.pt

# ---------------------------------------------------------------------------
# Interpreters. Training needs one with specforge installed; serving needs
# SGLang; DSpine needs the sglang-dspine plugin (pinned to sglang 0.5.22).
# ---------------------------------------------------------------------------
# SF_PY_TRAIN=/data/workspace/venv-specforge/bin/python
# SF_PY_SGLANG=/data/workspace/venv-sglang/bin/python
# SF_PY_DSPINE=/data/workspace/venv-dspine/bin/python

# SGLang's site-packages (holds the CUDA-13 libs put on LD_LIBRARY_PATH).
# SF_SGLANG_SITE=/data/workspace/venv-sglang/lib/python3.12/site-packages

# Suite manifest; defaults to configs/suite.yaml inside this repo.
# SF_SUITE=/data/workspace/specforge-experiments/configs/suite.yaml
